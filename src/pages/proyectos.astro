---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { laborAreas } from '../data/labor';
import { activitySlots, projectSlots } from '../data/projects';
import ContactCTA from '../components/sections/ContactCTA.astro';
import PageHero from '../components/sections/PageHero.astro';
import Button from '../components/ui/Button.astro';
import DraftNotice from '../components/ui/DraftNotice.astro';
import LaborIcon from '../components/ui/LaborIcon.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Proyectos y actividades"
  description="Líneas de trabajo y proyectos en preparación de Vivinka, asociación andina."
>
  <PageHero
    eyebrow="Proyectos y actividades"
    title="Iniciativas que nacen de la comunidad"
    description="Estamos construyendo las primeras propuestas de Vivinka. Aquí encontrarás las líneas de trabajo y los espacios reservados para los proyectos que vendrán."
  />

  <section class="pt-14 sm:pt-16">
    <div class="container-page">
      <DraftNotice>
        Esta sección está preparada para recibir los proyectos reales de la asociación. Los nombres,
        objetivos, fechas y resultados se publicarán cuando estén confirmados.
      </DraftNotice>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Líneas de trabajo"
        title="Desde dónde parten nuestros proyectos"
        description="Cada proyecto de Vivinka se vincula a uno o más de estos ámbitos."
      />

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          laborAreas.map((area) => (
            <article class="flex h-full flex-col rounded-3xl border border-line bg-canvas p-7">
              <span class="grid size-12 place-items-center rounded-2xl bg-primary-soft text-primary">
                <LaborIcon name={area.icon} />
              </span>
              <h3 class="mt-5 text-lg">{area.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{area.summary}</p>
              <a href={`/labor#${area.id}`} class="link-arrow mt-auto pt-6">
                Ver línea de trabajo
                <ArrowUpRight class="size-4" aria-hidden="true" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-page">
      <SectionHeading
        eyebrow="Proyectos"
        title="Espacios en preparación"
        description="Tres lugares reservados para las iniciativas que la asociación definirá próximamente."
      />

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {projectSlots.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <SectionHeading
          eyebrow="Actividades"
          title="Próximos encuentros"
          description="Cuando el calendario esté definido, las actividades se anunciarán en este espacio."
        />
        <Button href="/contacto" class="mt-7">
          Quiero recibir novedades
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
      </div>

      <ul class="divide-y divide-line overflow-hidden rounded-3xl border border-line bg-canvas">
        {
          activitySlots.map((activity) => (
            <li class="flex flex-wrap items-center justify-between gap-4 px-6 py-5">
              <div>
                <p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-primary">
                  {activity.category}
                </p>
                <p class="mt-1.5 font-serif text-lg text-ink">{activity.title}</p>
              </div>
              <span class="rounded-full bg-surface px-3 py-1.5 text-xs font-medium text-muted">
                {activity.date}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCTA />
</Layout>
