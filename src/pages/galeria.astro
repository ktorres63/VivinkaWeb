---
import ContactCTA from '../components/sections/ContactCTA.astro';
import PageHero from '../components/sections/PageHero.astro';
import DraftNotice from '../components/ui/DraftNotice.astro';
import GalleryTile from '../components/ui/GalleryTile.astro';
import { galleryItems } from '../data/gallery';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Galería"
  description="Galería de imágenes de Vivinka: encuentros, cultura, talleres y territorio andino."
>
  <PageHero
    eyebrow="Galería"
    title="La memoria también se mira"
    description="Un espacio para las fotografías de nuestros encuentros, talleres, paisajes y expresiones culturales."
  />

  <section class="section">
    <div class="container-page">
      <DraftNotice class="mb-12">
        La galería se encuentra en construcción. Las fotografías se incorporarán a medida que la
        asociación las comparta y autorice su publicación.
      </DraftNotice>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {galleryItems.map((item, index) => <GalleryTile item={item} index={index} />)}
      </div>

      <div class="mt-12 rounded-3xl border border-dashed border-line px-6 py-10 text-center">
        <p class="font-serif text-xl text-ink">¿Tienes fotografías de Vivinka?</p>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed text-muted">
          Si formas parte de la comunidad y quieres compartir imágenes de nuestros encuentros,
          escríbenos. Publicaremos solo las fotografías autorizadas.
        </p>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
