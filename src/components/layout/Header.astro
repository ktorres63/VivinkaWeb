---
import { ChevronDown, Menu } from '@lucide/astro';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { getTranslations, localePath, stripLocale } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  /** `overlay` deja el encabezado transparente sobre el hero. */
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const basePath = stripLocale(Astro.url.pathname);
const isOverlay = variant === 'overlay';

const navItems = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.about, href: '/nosotros' },
  { label: t.nav.labor, href: '/labor' },
  { label: t.nav.projects, href: '/proyectos' },
  { label: t.nav.gallery, href: '/galeria' },
  { label: t.nav.contact, href: '/contacto' },
];

const isActive = (href: string) =>
  href === '/' ? basePath === '/' : basePath.startsWith(href);
---

<header
  data-site-header
  data-variant={variant}
  class:list={[
    'z-50 w-full transition-[background-color,border-color,box-shadow] duration-300',
    isOverlay ? 'fixed inset-x-0 top-0' : 'sticky top-0',
  ]}
>
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href={localePath(locale, '/')} class="inline-flex items-center" aria-label={t.header.home}>
      {
        isOverlay ? (
          <>
            <img
              src="/images/vivinkaLogoLight.png"
              alt="Vivinka"
              width="768"
              height="325"
              class="header-logo header-logo--light h-10 w-auto object-contain sm:h-11"
            />
            <img
              src="/images/vivinkaLogo.png"
              alt=""
              aria-hidden="true"
              width="768"
              height="325"
              class="header-logo header-logo--dark h-10 w-auto object-contain sm:h-11"
            />
          </>
        ) : (
          <img
            src="/images/vivinkaLogo.png"
            alt="Vivinka"
            width="768"
            height="325"
            class="header-logo h-12 w-auto object-contain sm:h-14"
          />
        )
      }
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      <nav aria-label="Navegación principal">
        <ul class="flex items-center gap-0.5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={localePath(locale, item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="header-link"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <SocialLinks locale={locale} class="hidden xl:flex" />
      <LanguageSwitcher locale={locale} class="hidden xl:flex" />
    </div>

    <details class="group relative lg:hidden">
      <summary class="header-toggle">
        <Menu class="size-4" aria-hidden="true" />
        {t.header.menu}
        <ChevronDown
          class="size-4 opacity-70 transition-transform duration-200 group-open:rotate-180"
          aria-hidden="true"
        />
      </summary>

      <div
        class="header-menu absolute right-0 mt-3 w-64 overflow-hidden rounded-2xl border border-line bg-canvas p-2 shadow-xl"
      >
        <nav aria-label="Navegación móvil">
          <ul class="flex flex-col">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={localePath(locale, item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition-colors',
                      isActive(item.href)
                        ? 'bg-primary-soft text-primary'
                        : 'text-ink hover:bg-surface',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-2 flex items-center justify-between gap-3 border-t border-line px-3 pt-3">
          <SocialLinks locale={locale} />
          <LanguageSwitcher locale={locale} />
        </div>
      </div>
    </details>
  </div>
</header>

{
  isOverlay && (
    <script>
      const overlayHeaders = document.querySelectorAll<HTMLElement>(
        '[data-site-header][data-variant="overlay"]',
      );

      const updateHeaders = () => {
        overlayHeaders.forEach((header) => {
          header.classList.toggle('is-scrolled', window.scrollY > 32);
        });
      };

      updateHeaders();
      window.addEventListener('scroll', updateHeaders, { passive: true });
    </script>
  )
}
