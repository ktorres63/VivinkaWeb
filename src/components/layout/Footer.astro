---
import Logo from '../ui/Logo.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const year = new Date().getFullYear();

const navItems = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.about, href: '/nosotros' },
  { label: t.nav.labor, href: '/labor' },
  { label: t.nav.projects, href: '/proyectos' },
  { label: t.nav.gallery, href: '/galeria' },
];
---

<footer class="relative overflow-hidden bg-primary-dark text-white">
  <div class="pattern-andean absolute inset-0 text-white opacity-[0.05]" aria-hidden="true"></div>

  <div class="container-page relative py-16 sm:py-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo tone="light" />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-white/70">{t.footer.description}</p>
        <SocialLinks locale={locale} class="footer-social mt-6" />
      </div>

      <div>
        <h2 class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-white/50">
          {t.footer.explore}
        </h2>
        <ul class="mt-5 space-y-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={localePath(locale, item.href)}
                  class="text-sm text-white/75 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-white/50">
          {t.footer.contact}
        </h2>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/70">{t.footer.contactPending}</p>
        <a
          href={localePath(locale, '/contacto')}
          class="mt-5 inline-flex items-center justify-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-primary-dark transition-colors hover:bg-primary-soft"
        >
          {t.footer.goToContact}
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Vivinka. {t.footer.rights}</p>
      <p>{t.footer.tagline}</p>
    </div>
  </div>
</footer>
