---
import Chakana from './Chakana.astro';

interface Props {
  tone?: 'default' | 'light';
  class?: string;
}

const { tone = 'default', class: className } = Astro.props;
---

<span class:list={['flex items-center gap-3', className]}>
  <span
    class:list={[
      'grid size-11 place-items-center rounded-2xl',
      tone === 'light'
        ? 'bg-white/10 text-white ring-1 ring-white/25'
        : 'bg-primary text-white shadow-[0_12px_30px_-14px_rgba(10,104,8,0.9)]',
    ]}
  >
    <Chakana class="size-6" />
  </span>
  <span class="flex flex-col">
    <span
      class:list={[
        'font-serif text-[1.35rem] font-semibold leading-none tracking-tight',
        tone === 'light' ? 'text-white' : 'text-ink',
      ]}
    >
      Vivinka
    </span>
    <span
      class:list={[
        'mt-1.5 text-[0.6rem] font-medium uppercase tracking-[0.22em]',
        tone === 'light' ? 'text-white/60' : 'text-muted',
      ]}
    >
      Asociación andina
    </span>
  </span>
</span>
