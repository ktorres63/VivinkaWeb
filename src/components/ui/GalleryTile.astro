---
import { ImageIcon } from '@lucide/astro';
import type { GalleryItem, GalleryTone } from '../../data/gallery';

interface Props {
  item: GalleryItem;
  index: number;
  class?: string;
}

const { item, index, class: className } = Astro.props;

const tones: Record<GalleryTone, { shell: string; caption: string }> = {
  deep: { shell: 'bg-primary-dark text-white', caption: 'border-white/15 text-white/65' },
  mid: { shell: 'bg-primary text-white', caption: 'border-white/20 text-white/70' },
  soft: { shell: 'bg-primary-soft text-primary', caption: 'border-primary/10 text-primary/70' },
  canvas: { shell: 'bg-surface text-primary', caption: 'border-primary/10 text-primary/70' },
};

const tone = tones[item.tone];
const number = String(index + 1).padStart(2, '0');
---

<figure
  class:list={[
    'group overflow-hidden rounded-2xl border border-line',
    tone.shell,
    className,
  ]}
>
  {
    item.src ? (
      <img
        src={item.src}
        alt={item.alt ?? item.title}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="relative aspect-[4/3]">
        <div class="pattern-andean absolute inset-0 opacity-25" aria-hidden="true" />
        <div class="absolute inset-0 grid place-items-center">
          <span class="grid size-12 place-items-center rounded-full bg-white/15 backdrop-blur">
            <ImageIcon class="size-5" aria-hidden="true" stroke-width={1.5} />
          </span>
        </div>
        <span class="absolute left-4 top-4 rounded-full bg-black/15 px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.14em] backdrop-blur">
          {item.category}
        </span>
        <span class="absolute bottom-4 left-4 right-4 font-serif text-lg leading-tight">
          {item.title}
        </span>
      </div>
    )
  }

  <figcaption
    class:list={[
      'flex items-center justify-between gap-3 border-t px-4 py-3 text-[0.7rem] font-medium',
      tone.caption,
    ]}
  >
    <span>{item.src ? item.title : 'Fotografía por incorporar'}</span>
    <span class="font-semibold tracking-[0.08em]">{number}</span>
  </figcaption>
</figure>
