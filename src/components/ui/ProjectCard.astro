---
import type { ProjectSlot } from '../../data/projects';

interface Props {
  project: ProjectSlot;
}

const { project } = Astro.props;
---

<article class="card-hover flex h-full flex-col rounded-3xl border border-line bg-canvas p-7">
  <div class="flex items-start justify-between gap-3">
    <span class="font-serif text-3xl leading-none text-primary/20">{project.number}</span>
    <span
      class="rounded-full bg-surface px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-muted"
    >
      {project.status}
    </span>
  </div>
  <p class="mt-7 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-primary">
    {project.category}
  </p>
  <h3 class="mt-2 text-xl">{project.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{project.summary}</p>
  <span class="mt-auto pt-6 text-xs font-medium text-muted/80">
    Información por confirmar
  </span>
</article>
