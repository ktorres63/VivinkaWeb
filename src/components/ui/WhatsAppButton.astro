---
import BrandIcon from './BrandIcon.astro';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';
import { whatsapp } from '../../data/site';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);

// Mensaje precargado en WhatsApp para facilitar el primer contacto.
const separator = whatsapp.href.includes('?') ? '&' : '?';
const href = `${whatsapp.href}${separator}text=${encodeURIComponent(t.header.whatsappMessage)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.header.whatsapp}
  title={t.header.whatsapp}
  class="group fixed bottom-5 right-5 z-40 inline-flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_14px_30px_-10px_rgba(6,71,5,0.6)] transition-transform duration-200 hover:-translate-y-0.5 hover:bg-[#1fbe5a] sm:bottom-6 sm:right-6"
  data-whatsapp
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-ink px-3 py-1.5 text-xs font-semibold text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 lg:block"
  >
    {whatsapp.display}
  </span>

  <BrandIcon name="whatsapp" class="size-7" />
</a>
