---
import { Mail } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';
import { socialLinks } from '../../data/site';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = getTranslations(locale);
---

<ul class:list={['flex items-center gap-1', className]} aria-label={t.header.social}>
  {
    socialLinks.map(({ id, label, icon, href }) => (
      <li>
        <a href={href} class="social-link" aria-label={label} title={label} data-social={id}>
          {icon === 'mail' ? (
            <Mail class="size-[18px]" aria-hidden="true" stroke-width={1.75} />
          ) : (
            <BrandIcon name={icon} class="size-[18px]" />
          )}
        </a>
      </li>
    ))
  }
</ul>
