---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  as: Heading = 'h2',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <p class:list={['eyebrow', align === 'center' && 'justify-center']}>
        {eyebrow}
      </p>
    )
  }
  <Heading class="mt-4 text-3xl leading-tight text-balance sm:text-4xl">{title}</Heading>
  {
    description && (
      <p class:list={['mt-4 text-base leading-relaxed text-muted sm:text-lg', align === 'center' && 'mx-auto']}>
        {description}
      </p>
    )
  }
</div>
