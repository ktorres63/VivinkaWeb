---
import { getTranslations, localePath, stripLocale } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = getTranslations(locale);
const currentPath = stripLocale(Astro.url.pathname);
const languages: Locale[] = ['es', 'en'];
---

<div class:list={['lang-switch', className]}>
  <ul class="flex items-center gap-0.5" aria-label={t.header.language}>
    {
      languages.map((code) => (
        <li>
          <a
            href={localePath(code, currentPath)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
            class="lang-link"
          >
            {code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</div>
