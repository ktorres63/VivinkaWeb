---
import { PencilLine } from '@lucide/astro';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
---

<aside
  class:list={[
    'flex items-start gap-3 rounded-2xl border border-line bg-surface px-5 py-4 text-sm leading-relaxed text-muted',
    className,
  ]}
>
  <PencilLine class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true" />
  <p>
    <strong class="font-semibold text-ink">{t.common.draftTitle}</strong>{' '}
    <slot />
  </p>
</aside>
