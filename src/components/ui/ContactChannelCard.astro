---
import { MapPin, Mail, Phone, Share2 } from '@lucide/astro';
import type { ContactChannel } from '../../data/site';

interface Props {
  channel: ContactChannel;
}

const { channel } = Astro.props;

const icons = {
  mail: Mail,
  phone: Phone,
  'map-pin': MapPin,
  share: Share2,
} as const;

const Icon = icons[channel.icon];
---

<div class="flex h-full flex-col rounded-3xl border border-line bg-canvas p-7">
  <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary">
    <Icon class="size-5" aria-hidden="true" stroke-width={1.75} />
  </span>

  <p class="mt-5 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-muted">
    {channel.label}
  </p>
  <p class="mt-2 font-serif text-xl text-ink">{channel.value}</p>

  {channel.note && <p class="mt-3 text-sm leading-relaxed text-muted">{channel.note}</p>}

  {
    channel.href && (
      <a href={channel.href} class="link-arrow mt-auto pt-5">
        Escribir
      </a>
    )
  }
</div>
