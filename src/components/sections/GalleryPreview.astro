---
import { ArrowRight } from '@lucide/astro';
import { galleryItems } from '../../data/gallery';
import Button from '../ui/Button.astro';
import GalleryTile from '../ui/GalleryTile.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.home.gallery;
const preview = galleryItems[locale].slice(0, 4);
---

<section class="section bg-surface">
  <div class="container-page">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />
      <Button href={localePath(locale, '/galeria')} variant="secondary" class="shrink-0">
        {copy.cta}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {preview.map((item, index) => <GalleryTile item={item} index={index} />)}
    </div>
  </div>
</section>
