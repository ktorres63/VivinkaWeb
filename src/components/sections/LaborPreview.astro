---
import { ArrowUpRight } from '@lucide/astro';
import { laborAreas } from '../../data/labor';
import Button from '../ui/Button.astro';
import LaborIcon from '../ui/LaborIcon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.home.labor;
const areas = laborAreas[locale];
---

<section class="section bg-surface">
  <div class="container-page">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />
      <Button href={localePath(locale, '/labor')} variant="secondary" class="shrink-0">
        {copy.cta}
      </Button>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        areas.map((area) => (
          <article class="card-hover flex h-full flex-col rounded-3xl border border-line bg-canvas p-7">
            <span class="grid size-12 place-items-center rounded-2xl bg-primary-soft text-primary">
              <LaborIcon name={area.icon} />
            </span>
            <p class="mt-6 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-primary">
              {area.eyebrow}
            </p>
            <h3 class="mt-2 text-xl">{area.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{area.summary}</p>
            <a href={localePath(locale, `/labor#${area.id}`)} class="link-arrow mt-auto pt-6">
              {copy.cardLink}
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
