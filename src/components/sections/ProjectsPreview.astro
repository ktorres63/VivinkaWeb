---
import { ArrowRight } from '@lucide/astro';
import { projectSlots } from '../../data/projects';
import Button from '../ui/Button.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.home.projects;
const projects = projectSlots[locale];
---

<section class="section">
  <div class="container-page">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />
      <Button href={localePath(locale, '/proyectos')} variant="secondary" class="shrink-0">
        {copy.cta}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
