---
import { heroSlides } from '../../data/home';
---

<section
  data-hero-slider
  aria-label="Presentación principal de Vivinka"
  class="relative h-[calc(100vh-80px)] min-h-[611px] w-full overflow-hidden bg-ink"
>
  <ul class="absolute inset-0 block">
    {
      heroSlides.map((slide, i) => {
        const TitleTag = i === 0 ? 'h1' : 'h2';
        return (
          <li
            data-hero-slide={i}
            class:list={[
              'absolute inset-0 w-full bg-cover bg-center transition-opacity duration-700',
              i === 0 ? 'z-10 opacity-100' : 'pointer-events-none z-0 opacity-0',
            ]}
            style={`background-image: url('${slide.image}');`}
            aria-hidden={i !== 0 ? 'true' : 'false'}
          >
            <img
              src={slide.image}
              alt={slide.alt}
              class="sr-only"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />

            {/* Oscurece la imagen para que resalte el texto */}
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-[linear-gradient(90deg,rgba(6,25,6,0.72)_0%,rgba(6,25,6,0.42)_55%,rgba(0,0,0,0.15)_100%)]"
            />

            <div class="relative z-10 mx-auto flex h-full w-full max-w-[1300px] items-center px-[15px] sm:px-8 lg:pb-[70px] lg:pt-[140px]">
              <div class="max-w-3xl text-left">
                <p class="mb-[8px] whitespace-pre-line text-[18px] font-medium leading-[28px] tracking-wide text-white/90 sm:text-[20px]">
                  {slide.kicker}
                </p>

                <TitleTag class="mb-[48px] font-serif text-[44px] font-bold leading-[1.05] text-white sm:text-[54px] lg:mb-[60px] lg:text-[80px] lg:leading-[1.02]">
                  <span class="block font-sans text-[24px] font-medium leading-[1.3] text-white/95 sm:text-[28px] lg:text-[42px] lg:leading-[1.25]">
                    {slide.titleLead}
                  </span>
                  {slide.title}
                </TitleTag>

                <a
                  // href={slide.href}
                  href="#"
                  class="group relative inline-flex h-[63px] w-[186px] cursor-pointer items-center rounded-[10px] border border-white px-5 text-[20px] font-medium text-white transition-colors duration-200 hover:bg-white hover:text-ink"
                >
                  <span>{slide.cta}</span>
                  <span
                    aria-hidden="true"
                    class="absolute right-5 top-1/2 -translate-y-1/2 text-[15px] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-ink"
                  >
                    &gt;
                  </span>
                </a>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  {/* Pager */}
  <div
    class="absolute right-[16px] top-[55%] z-20 flex -translate-y-1/2 flex-col items-center gap-3 sm:right-[24px]"
    role="tablist"
    aria-label="Seleccionar diapositiva"
  >
    {
      heroSlides.map((_, i) => (
        <button
          type="button"
          data-hero-dot={i}
          aria-label={`Ir a la diapositiva ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}
          class:list={[
            'h-3.5 w-3.5 cursor-pointer rounded-full border border-white transition-colors duration-200',
            i === 0 ? 'bg-accent' : 'bg-white hover:bg-accent',
          ]}
        />
      ))
    }
  </div>
</section>

<script>
  const sliders = document.querySelectorAll<HTMLElement>('[data-hero-slider]');

  sliders.forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const total = slides.length;
    if (total <= 1) return;

    let index = 0;
    let timerId: number | undefined;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (nextIndex: number) => {
      index = ((nextIndex % total) + total) % total;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('z-10', active);
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('z-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('bg-accent', active);
        dot.classList.toggle('bg-white', !active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
    };

    const startTimer = () => {
      if (prefersReducedMotion) return;
      stopTimer();
      timerId = window.setInterval(() => {
        goTo(index + 1);
      }, 6000);
    };

    const stopTimer = () => {
      if (timerId !== undefined) {
        window.clearInterval(timerId);
        timerId = undefined;
      }
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(i);
        startTimer();
      });
    });

    slider.addEventListener('mouseenter', stopTimer);
    slider.addEventListener('mouseleave', startTimer);

    startTimer();
  });
</script>
