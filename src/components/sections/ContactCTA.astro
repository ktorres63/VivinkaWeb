---
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Chakana from '../ui/Chakana.astro';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.home.contact;
---

<section class="pb-20 sm:pb-24">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-primary-dark px-6 py-14 text-white sm:px-12 sm:py-16">
      <div class="pattern-andean absolute inset-0 text-white opacity-[0.07]" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <p class="eyebrow eyebrow-light">{copy.eyebrow}</p>
        <h2 class="mt-5 text-3xl leading-tight text-white text-balance sm:text-4xl">{copy.title}</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-white/75">{copy.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={localePath(locale, '/contacto')} variant="light">
            {copy.primaryCta}
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button href={localePath(locale, '/proyectos')} variant="outline-light">
            {copy.secondaryCta}
          </Button>
        </div>
      </div>

      <Chakana class="absolute -bottom-10 -right-6 size-48 text-white/10 sm:size-64" />
    </div>
  </div>
</section>
