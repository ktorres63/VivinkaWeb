---
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Chakana from '../ui/Chakana.astro';
---

<section class="pb-20 sm:pb-24">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-primary-dark px-6 py-14 text-white sm:px-12 sm:py-16">
      <div class="pattern-andean absolute inset-0 text-white opacity-[0.07]" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <p class="eyebrow eyebrow-light">Contacto</p>
        <h2 class="mt-5 text-3xl leading-tight text-white text-balance sm:text-4xl">
          ¿Quieres conocer Vivinka?
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-white/75">
          Escríbenos o acércate a nuestras actividades. Estaremos compartiendo novedades y formas de
          participar muy pronto.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contacto" variant="light">
            Ir a contacto
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button href="/proyectos" variant="outline-light">Ver proyectos</Button>
        </div>
      </div>

      <Chakana
        class="absolute -bottom-10 -right-6 size-48 text-white/10 sm:size-64"
      />
    </div>
  </div>
</section>
