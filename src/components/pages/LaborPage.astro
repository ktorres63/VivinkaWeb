---
import { Check } from '@lucide/astro';
import ContactCTA from '../sections/ContactCTA.astro';
import PageHero from '../sections/PageHero.astro';
import Button from '../ui/Button.astro';
import DraftNotice from '../ui/DraftNotice.astro';
import LaborIcon from '../ui/LaborIcon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { laborAreas, participationSteps } from '../../data/labor';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.labor;
const areas = laborAreas[locale];
const steps = participationSteps[locale];
---

<Layout title={t.meta.labor.title} description={t.meta.labor.description}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    description={copy.hero.description}
  />

  <section class="pb-4 pt-14 sm:pt-16">
    <div class="container-page">
      <DraftNotice>{copy.draft}</DraftNotice>
    </div>
  </section>

  {
    areas.map((area, index) => (
      <section id={area.id} class:list={['section', index % 2 === 1 && 'bg-surface']}>
        <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
          <div>
            <p class="eyebrow">{area.eyebrow}</p>
            <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">{area.title}</h2>
            <p class="mt-5 leading-relaxed text-muted">{area.summary}</p>

            <div class="mt-8 flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-2xl bg-primary text-white">
                <LaborIcon name={area.icon} />
              </span>
              <span class="font-serif text-5xl leading-none text-primary/15">0{index + 1}</span>
            </div>
          </div>

          <div class="rounded-3xl border border-line bg-canvas p-7 sm:p-9">
            <h3 class="font-sans text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-muted">
              {copy.whatWeDo}
            </h3>
            <ul class="mt-6 space-y-4">
              {area.points.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-primary-soft text-primary">
                    <Check class="size-3.5" aria-hidden="true" stroke-width={2.5} />
                  </span>
                  <span class="text-sm leading-relaxed text-muted">{point}</span>
                </li>
              ))}
            </ul>
            <p class="mt-7 border-t border-line pt-5 text-xs leading-relaxed text-muted">
              {copy.upcoming}
            </p>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section bg-surface">
    <div class="container-page">
      <SectionHeading
        align="center"
        eyebrow={copy.participate.eyebrow}
        title={copy.participate.title}
        description={copy.participate.description}
      />

      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="rounded-3xl border border-line bg-canvas p-8">
              <span class="grid size-11 place-items-center rounded-full bg-primary-soft font-serif text-lg font-semibold text-primary">
                {index + 1}
              </span>
              <h3 class="mt-5 text-xl">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 flex justify-center">
        <Button href={localePath(locale, '/contacto')}>{copy.participate.cta}</Button>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
