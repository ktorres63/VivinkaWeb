---
import { HandHeart, Mountain, Sprout, Users } from '@lucide/astro';
import ContactCTA from '../sections/ContactCTA.astro';
import PageHero from '../sections/PageHero.astro';
import DraftNotice from '../ui/DraftNotice.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

// Contenido provisional: historia, misión, visión y valores deben validarse
// con la asociación antes de la publicación definitiva.

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.about;

const values = [
  { icon: Mountain, ...copy.values.items[0] },
  { icon: Users, ...copy.values.items[1] },
  { icon: HandHeart, ...copy.values.items[2] },
  { icon: Sprout, ...copy.values.items[3] },
];
---

<Layout title={t.meta.about.title} description={t.meta.about.description}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    description={copy.hero.description}
  />

  <section class="section">
    <div class="container-page">
      <DraftNotice class="mb-12">{copy.draft}</DraftNotice>

      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
        <div>
          <SectionHeading eyebrow={copy.who.eyebrow} title={copy.who.title} />

          <div class="mt-5 space-y-4 leading-relaxed text-muted">
            <p>{copy.who.paragraph1}</p>
            <p>{copy.who.paragraph2}</p>
            <p class="rounded-2xl border border-dashed border-line px-5 py-4 text-sm">
              {copy.who.historyNote}
            </p>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-[2.5rem] bg-primary-dark p-8 text-white sm:p-10">
          <div class="pattern-andean absolute inset-0 text-white opacity-[0.07]" aria-hidden="true"></div>

          <div class="relative">
            <p class="eyebrow eyebrow-light">{copy.name.eyebrow}</p>
            <p class="mt-5 font-serif text-3xl">Vivinka</p>
            <p class="mt-4 text-sm leading-relaxed text-white/70">{copy.name.note}</p>

            <dl class="mt-8 grid grid-cols-2 gap-5 border-t border-white/15 pt-6">
              <div>
                <dt class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/50">
                  {copy.name.natureLabel}
                </dt>
                <dd class="mt-2 text-sm text-white/85">{copy.name.natureValue}</dd>
              </div>
              <div>
                <dt class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/50">
                  {copy.name.areasLabel}
                </dt>
                <dd class="mt-2 text-sm text-white/85">{copy.name.areasValue}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-page">
      <SectionHeading
        eyebrow={copy.mission.eyebrow}
        title={copy.mission.title}
        description={copy.mission.description}
      />

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <article class="rounded-3xl border border-line bg-canvas p-8">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-2xl">{copy.mission.missionTitle}</h3>
            <span class="rounded-full bg-surface px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-muted">
              {copy.mission.provisional}
            </span>
          </div>
          <p class="mt-4 leading-relaxed text-muted">{copy.mission.missionText}</p>
        </article>

        <article class="rounded-3xl border border-line bg-canvas p-8">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-2xl">{copy.mission.visionTitle}</h3>
            <span class="rounded-full bg-surface px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-muted">
              {copy.mission.provisional}
            </span>
          </div>
          <p class="mt-4 leading-relaxed text-muted">{copy.mission.visionText}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionHeading
        eyebrow={copy.values.eyebrow}
        title={copy.values.title}
        description={copy.values.description}
      />

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map(({ icon: Icon, title, text }) => (
            <article class="rounded-3xl border border-line bg-canvas p-7">
              <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary">
                <Icon class="size-5" aria-hidden="true" stroke-width={1.75} />
              </span>
              <h3 class="mt-5 text-lg">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
