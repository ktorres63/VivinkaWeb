---
import { ArrowRight } from '@lucide/astro';
import PageHero from '../sections/PageHero.astro';
import Button from '../ui/Button.astro';
import ContactChannelCard from '../ui/ContactChannelCard.astro';
import DraftNotice from '../ui/DraftNotice.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { contactChannels } from '../../data/site';
import { getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(locale);
const copy = t.contact;
const channels = contactChannels[locale];
---

<Layout title={t.meta.contact.title} description={t.meta.contact.description}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    description={copy.hero.description}
  />

  <section class="section">
    <div class="container-page">
      <DraftNotice class="mb-12">{copy.draft}</DraftNotice>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((channel) => <ContactChannelCard channel={channel} />)}
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <SectionHeading
        eyebrow={copy.meanwhile.eyebrow}
        title={copy.meanwhile.title}
        description={copy.meanwhile.description}
      />

      <div class="flex flex-wrap gap-3 lg:justify-end">
        <Button href={localePath(locale, '/labor')}>
          {copy.meanwhile.laborCta}
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        <Button href={localePath(locale, '/proyectos')} variant="secondary">
          {copy.meanwhile.projectsCta}
        </Button>
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-24">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-[2.5rem] border border-line bg-canvas px-6 py-12 sm:px-12">
        <div class="pattern-andean absolute inset-0 text-primary opacity-[0.05]" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <p class="eyebrow">{copy.closing.eyebrow}</p>
          <h2 class="mt-5 text-2xl leading-tight sm:text-3xl">{copy.closing.title}</h2>
          <p class="mt-4 leading-relaxed text-muted">{copy.closing.description}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
